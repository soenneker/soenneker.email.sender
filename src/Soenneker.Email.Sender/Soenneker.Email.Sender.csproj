<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A high-level utility responsible for orchestrating the creation and delivery of templated email messages</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Email.Sender</AssemblyName>
        <PackageId>Soenneker.Email.Sender</PackageId>
        <PackageTags>email sender mime utils smtp sending emailsender util csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2025-2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.email.sender</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.email.sender</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">
            $(PACKAGE_RELEASE_NOTES)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Email.Mime" Version="11.0.615" />
        <PackageReference Include="Soenneker.Email.Senders.Abstract" Version="11.0.220" />
        <PackageReference Include="Soenneker.Extensions.Dtos.Email" Version="11.0.505" />
        <PackageReference Include="Soenneker.Utils.Json" Version="11.0.2770" />
        <PackageReference Include="Soenneker.Utils.Template" Version="11.0.452" />
        <PackageReference Include="Soenneker.Extensions.Dictionaries.StringString" Version="11.0.42" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.Enumerable.String" Version="11.0.1501" />
        <PackageReference Include="Soenneker.Extensions.Task" Version="11.0.141" />
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="4.0.133" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Soenneker.Email.Sender.Tests" />
    </ItemGroup>
</Project>
